# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dhru

# Candle / OHLCV provider (required for paid prediction)
# Example: https://your-candle-provider.example/api/candles
CANDLE_API_URL=
CANDLE_API_KEY=

# Optional licensed news provider (headlines used by model explanation)
NEWS_API_URL=
NEWS_API_KEY=

# Razorpay (for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# App / session secrets
COOKIE_SIGNING_KEY=
NEXTAUTH_SECRET=
JWT_SECRET=

# App config
APP_ORIGIN=https://dhru.ltd
CANDLE_PROVIDER_TYPE=rest

# Optional ML service (if you deploy the Python service separately)
ML_SERVICE_URL=http://localhost:8000

# Rate limit (requests per minute per user)
RATE_LIMIT_RPM=60
